# Server
PORT=5001
NODE_ENV=development

# MongoDB (local dev) — for production use your MongoDB Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/analytics_dashboard

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Frontend origin allowed by CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5180

# Frontend origins allowed by CORS (comma-separated; "*" allowed in the host for preview deployments).
# Local dev servers and this project's own Vercel deployments are always allowed in addition.
# Production example: CLIENT_URL=https://my-dashboard.vercel.app,https://my-dashboard-*-team.vercel.app

# Demo role logins shown on the sign-in page (true/false)
DEMO_LOGIN_ENABLED=true
# Demo account passwords — synced into the database (bcrypt) at API start-up and by `npm run demo:sync`.
# Optional. Unset in production → a per-role password derived from JWT_REFRESH_SECRET is used and published
# on the login page; set a value (8+ chars, letter + number) to choose your own. Outside production, unset
# values fall back to Password123 so `npm run dev` works with no configuration.
DEMO_PASSWORD_SUPER_ADMIN=
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_ANALYST=
DEMO_PASSWORD_VIEWER=
