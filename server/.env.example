# Server
PORT=5001
NODE_ENV=development

# MongoDB (local dev) — for production use your MongoDB Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/analytics_dashboard

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Frontend origin allowed by CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5180
